[Unit]
Description=Purge expired EVENT CREW recoverable content
After=event-crew-backup.service

[Service]
Type=oneshot
User=eventcrew
Group=eventcrew
WorkingDirectory=/var/www/event-crew
Environment=NODE_ENV=production
EnvironmentFile=/var/www/event-crew/.env.local
ExecStart=/usr/bin/npm run purge:expired
PrivateTmp=true
NoNewPrivileges=true
