[Unit]
Description=EVENT CREW daily content backup
After=event-crew.service

[Service]
Type=oneshot
User=eventcrew
Group=eventcrew
WorkingDirectory=/var/www/event-crew
Environment=NODE_ENV=production
EnvironmentFile=/var/www/event-crew/.env.local
ExecStart=/usr/bin/npm run backup
PrivateTmp=true
NoNewPrivileges=true
